# Required. Generate independent random values for each key.
SECRET_KEY=replace-with-a-random-secret
AUDIT_INTEGRITY_KEY=replace-with-an-independent-audit-secret

# Local HTTP defaults. Enable Secure cookies only when serving HTTPS.
SESSION_COOKIE_SECURE=0
TRUSTED_HOSTS=

# Persistent login limits per window.
LOGIN_SOURCE_LIMIT=10
LOGIN_ACCOUNT_LIMIT=5
LOGIN_WINDOW_SECONDS=60

# Optional. For a new team account, set DEMO_<UPPERCASE_USERNAME>_PASSWORD
# privately to supply a value. Blank or unset values generate random passwords.
